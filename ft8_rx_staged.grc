- name: ft8_search
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFS =\
      \ 12000                      # decoder sample rate\nNSPS = 1920            \
      \         # samples per FT8 symbol (0.16 s)\nNN = 79                       \
      \  # symbols per transmission\nCOSTAS = np.array([3, 1, 4, 0, 6, 5, 2])\nGRAY\
      \ = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone\nDATA_SYMS\
      \ = np.r_[7:36, 43:72]\nSYNC_SYMS = np.r_[0:7, 36:43, 72:79]\n\n\n# ---- message\
      \ helpers: every stage passes one PMT dict per slot and pass ----\ndef to_msg(d):\n\
      \    \"\"\"Python dict -> PMT dict. numpy arrays become uniform vectors (fast\
      \ path).\"\"\"\n    m = pmt.make_dict()\n    for k, v in d.items():\n      \
      \  if isinstance(v, np.ndarray):\n            a = v.ravel()\n            if\
      \ a.dtype == np.uint8:\n                p = pmt.init_u8vector(len(a), a.tolist())\n\
      \            elif a.dtype.kind == 'i':\n                p = pmt.init_s32vector(len(a),\
      \ a.astype(np.int32).tolist())\n            elif a.dtype.kind == 'c':\n    \
      \            p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())\n\
      \            elif a.dtype == np.float64:\n                p = pmt.init_f64vector(len(a),\
      \ a.tolist())\n            else:\n                p = pmt.init_f32vector(len(a),\
      \ a.astype(np.float32).tolist())\n        else:\n            p = pmt.to_pmt(v)\n\
      \        m = pmt.dict_add(m, pmt.intern(k), p)\n    return m\n\n\ndef from_msg(m):\n\
      \    return pmt.to_python(m)\n\n\n# ----------------------------------------------------------------\
      \ DSP\n_TSTEP = 480                    # spectrogram hop: 1/4 symbol (40 ms)\n\
      _NFFT1 = 3840                   # 1920 samples zero-padded -> 3.125 Hz bins\n\
      _JSTRT = 12                     # 0.5 s / 40 ms\n_JZ = 62                  \
      \      # lag search +-62 steps (+-2.48 s)\n_MLAG = 10                      #\
      \ \"narrow\" lag search +-0.4 s\n\n\ndef sync_search(x, fmin, fmax, syncmin=1.3,\
      \ maxcand=300):\n    \"\"\"Coarse Costas search. Returns list of (f0 Hz, xdt\
      \ s, sync) and the baseline\n    (40th-percentile) spectrum power per 3.125\
      \ Hz bin.\"\"\"\n    nhsym = len(x) // _TSTEP - 3\n    idx = np.arange(nhsym)[:,\
      \ None] * _TSTEP + np.arange(NSPS)[None, :]\n    X = np.fft.rfft(x[idx], _NFFT1,\
      \ axis=1)\n    s = (X.real ** 2 + X.imag ** 2).T                     # (1921\
      \ bins, nhsym)\n    df = FS / _NFFT1\n    ia = max(1, int(round(fmin / df)))\n\
      \    ib = min(int(round(fmax / df)), s.shape[0] - 15)\n    nf = ib - ia + 1\n\
      \    pad = np.zeros((s.shape[0], _JZ + nhsym + _JZ + 300))\n    pad[:, _JZ:_JZ\
      \ + nhsym] = s\n    tones = np.stack([pad[ia + 2 * k: ia + 2 * k + nf] for k\
      \ in range(7)])   # (7,nf,T)\n    t_g = np.zeros((3, nf, 2 * _JZ + 1))\n   \
      \ t0_g = np.zeros((3, nf, 2 * _JZ + 1))\n    for g in range(3):\n        for\
      \ n in range(7):\n            m0 = _JSTRT + 4 * n + 144 * g                \
      \  # lag j=0 position\n            sl = tones[:, :, m0: m0 + 2 * _JZ + 1]  \
      \      # j = -JZ..JZ (pad offset JZ cancels)\n            t_g[g] += sl[COSTAS[n]]\n\
      \            t0_g[g] += sl.sum(axis=0)\n    eps = 1e-30\n    t = t_g.sum(0)\n\
      \    t0 = (t0_g.sum(0) - t) / 6.0\n    sync_abc = t / (t0 + eps)\n    tbc =\
      \ t_g[1] + t_g[2]\n    t0bc = (t0_g[1] + t0_g[2] - tbc) / 6.0\n    sync_bc =\
      \ tbc / (t0bc + eps)\n    sync2d = np.maximum(sync_abc, sync_bc)           \
      \      # (nf, 2JZ+1)\n    narrow = sync2d[:, _JZ - _MLAG: _JZ + _MLAG + 1]\n\
      \    jp1 = np.argmax(narrow, axis=1) - _MLAG\n    red1 = narrow.max(axis=1)\n\
      \    jp2 = np.argmax(sync2d, axis=1) - _JZ\n    red2 = sync2d.max(axis=1)\n\
      \    base1 = np.sort(red1)[int(round(0.40 * nf))]\n    base2 = np.sort(red2)[int(round(0.40\
      \ * nf))]\n    red1 = red1 / max(base1, eps)\n    red2 = red2 / max(base2, eps)\n\
      \    cand = []\n    for red, jp in ((red1, jp1), (red2, jp2)):\n        order\
      \ = np.argsort(-red)[:maxcand]\n        for i in order:\n            if red[i]\
      \ < syncmin:\n                break\n            cand.append(((ia + i) * df,\
      \ (jp[i] - 0.5) * (_TSTEP / FS), float(red[i])))\n    # remove near-duplicates\
      \ (keep stronger)\n    cand.sort(key=lambda c: -c[2])\n    keep = []\n    for\
      \ c in cand:\n        if all(abs(c[0] - k[0]) >= 4.0 or abs(c[1] - k[1]) >=\
      \ 0.04 for k in keep):\n            keep.append(c)\n        if len(keep) >=\
      \ maxcand:\n            break\n    # baseline noise spectrum (per 3.125 Hz bin),\
      \ robust to signals\n    base_spec = np.percentile(s, 40, axis=1)\n    return\
      \ keep, base_spec\n\n\n\n\n# ================================================================\
      \ Stage 2 block\nclass blk(gr.basic_block):\n    \"\"\"FT8 Sync Search: slot\
      \ audio -> candidate list.\n\n    Builds a 3.125 Hz x 40 ms power spectrogram\
      \ of the slot and scores the three\n    7x7 Costas sync arrays at every frequency\
      \ and time lag (-2.5 .. +2.5 s).\n    Pass 0 audio comes from the Slot Clock;\
      \ later passes are residual audio from\n    FT8 Subtract (same input port).\n\
      \    Output 'cand': input fields + f0[], xdt[], sync[], base[] (noise baseline\
      \ per bin)\n    \"\"\"\n\n    def __init__(self, f_min=200.0, f_max=3000.0,\
      \ syncmin=1.2, maxcand=400):\n        gr.basic_block.__init__(self, name='FT8\
      \ Sync Search', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('slot'))\n\
      \        self.message_port_register_out(pmt.intern('cand'))\n        self.set_msg_handler(pmt.intern('slot'),\
      \ self.handle)\n        self.f_min, self.f_max = float(f_min), float(f_max)\n\
      \        self.syncmin, self.maxcand = float(syncmin), int(maxcand)\n\n    def\
      \ handle(self, m):\n        d = from_msg(m)\n        x = np.asarray(d['audio'],\
      \ dtype=np.float64)\n        if d['pass'] == 0:\n            x = x / (np.std(x)\
      \ + 1e-12)               # unit power; residuals keep this scale\n        cands,\
      \ base = sync_search(x, self.f_min, self.f_max, self.syncmin, self.maxcand)\
      \ if np.any(x) else ([], np.zeros(1))\n        d['audio'] = x.astype(np.float32)\n\
      \        d['f0'] = np.array([c[0] for c in cands], dtype=np.float64)\n     \
      \   d['xdt'] = np.array([c[1] for c in cands], dtype=np.float64)\n        d['sync']\
      \ = np.array([c[2] for c in cands], dtype=np.float64)\n        if 'base' not\
      \ in d:                            # keep the pass-0 noise baseline for SNR\n\
      \            d['base'] = base.astype(np.float64)\n        self.message_port_pub(pmt.intern('cand'),\
      \ to_msg(d))\n"
    affinity: ''
    alias: ''
    comment: '2. Costas sync search over the slot spectrogram

      -> candidate (frequency, time) list'
    f_max: f_max
    f_min: f_min
    maxcand: '400'
    maxoutbuf: '0'
    minoutbuf: '0'
    syncmin: '1.2'
  states:
    _io_cache: '(''FT8 Sync Search'', ''blk'', [(''f_min'', ''200.0''), (''f_max'',
      ''3000.0''), (''syncmin'', ''1.2''), (''maxcand'', ''400'')], [(''slot'', ''message'',
      1)], [(''cand'', ''message'', 1)], "FT8 Sync Search: slot audio -> candidate
      list.\n\n    Builds a 3.125 Hz x 40 ms power spectrogram of the slot and scores
      the three\n    7x7 Costas sync arrays at every frequency and time lag (-2.5
      .. +2.5 s).\n    Pass 0 audio comes from the Slot Clock; later passes are residual
      audio from\n    FT8 Subtract (same input port).\n    Output ''cand'': input
      fields + f0[], xdt[], sync[], base[] (noise baseline per bin)\n    ", [''f_max'',
      ''f_min'', ''maxcand'', ''syncmin''])'
    bus_sink: false
    bus_source: false
