- name: ft8_subtract
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFS =\
      \ 12000                      # decoder sample rate\nNSPS = 1920            \
      \         # samples per FT8 symbol (0.16 s)\nNN = 79                       \
      \  # symbols per transmission\nCOSTAS = np.array([3, 1, 4, 0, 6, 5, 2])\nGRAY\
      \ = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone\nDATA_SYMS\
      \ = np.r_[7:36, 43:72]\nSYNC_SYMS = np.r_[0:7, 36:43, 72:79]\n\n\n# ---- message\
      \ helpers: every stage passes one PMT dict per slot and pass ----\ndef to_msg(d):\n\
      \    \"\"\"Python dict -> PMT dict. numpy arrays become uniform vectors (fast\
      \ path).\"\"\"\n    m = pmt.make_dict()\n    for k, v in d.items():\n      \
      \  if isinstance(v, np.ndarray):\n            a = v.ravel()\n            if\
      \ a.dtype == np.uint8:\n                p = pmt.init_u8vector(len(a), a.tolist())\n\
      \            elif a.dtype.kind == 'i':\n                p = pmt.init_s32vector(len(a),\
      \ a.astype(np.int32).tolist())\n            elif a.dtype.kind == 'c':\n    \
      \            p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())\n\
      \            elif a.dtype == np.float64:\n                p = pmt.init_f64vector(len(a),\
      \ a.tolist())\n            else:\n                p = pmt.init_f32vector(len(a),\
      \ a.astype(np.float32).tolist())\n        else:\n            p = pmt.to_pmt(v)\n\
      \        m = pmt.dict_add(m, pmt.intern(k), p)\n    return m\n\n\ndef from_msg(m):\n\
      \    return pmt.to_python(m)\n\n\n# ----------------------------------------------------------------\
      \ signal subtraction\ndef _gfsk_pulse(bt, t):\n    from math import erf, pi,\
      \ sqrt, log\n    c = pi * sqrt(2.0 / log(2.0))\n    v = np.vectorize(erf)\n\
      \    return 0.5 * (v(c * bt * (t + 0.5)) - v(c * bt * (t - 0.5)))\n\n\n_PULSE\
      \ = _gfsk_pulse(2.0, (np.arange(3 * NSPS) - 1.5 * NSPS) / NSPS)\n\n\ndef gfsk_ref(tones,\
      \ f0):\n    \"\"\"Unit-amplitude complex FT8 waveform (79 symbols, GFSK BT=2)\
      \ at f0 Hz, 12 kHz.\"\"\"\n    hmod = 2.0 * np.pi / NSPS\n    dphi = np.zeros((NN\
      \ + 2) * NSPS)\n    for j, tn in enumerate(tones):\n        dphi[j * NSPS: j\
      \ * NSPS + 3 * NSPS] += hmod * tn * _PULSE\n    dphi[0:2 * NSPS] += hmod * tones[0]\
      \ * _PULSE[NSPS:3 * NSPS]\n    dphi[NN * NSPS:(NN + 2) * NSPS] += hmod * tones[-1]\
      \ * _PULSE[0:2 * NSPS]\n    dphi += 2.0 * np.pi * f0 / FS\n    phi = np.concatenate([[0.0],\
      \ np.cumsum(dphi[NSPS:NSPS + NN * NSPS - 1])])\n    return np.exp(1j * phi)\n\
      \n\n_NFILT = 4000\n_WFILT = np.cos(np.pi * (np.arange(_NFILT) - _NFILT // 2)\
      \ / _NFILT) ** 2\n_WFILT /= _WFILT.sum()\n\n\n_DEN_CACHE = {}\n\n\ndef _fftconv_same(v):\n\
      \    n = len(v) + _NFILT - 1\n    nf = 1 << int(np.ceil(np.log2(n)))\n    r\
      \ = np.fft.ifft(np.fft.fft(v, nf) * np.fft.fft(_WFILT, nf))[:n]\n    s = (_NFILT\
      \ - 1) // 2\n    return r[s:s + len(v)]\n\n\ndef subtract(x, tones, f0, t0):\n\
      \    \"\"\"Remove one decoded signal from x (in place). t0 = start time in s\
      \ from slot start.\"\"\"\n    cref = gfsk_ref(tones, f0)\n    n0 = int(round(t0\
      \ * FS))\n    a, b = max(0, n0), min(len(x), n0 + len(cref))\n    if b - a <\
      \ NSPS:\n        return\n    cr = cref[a - n0: b - n0]\n    camp = x[a:b] *\
      \ np.conj(cr)\n    num = _fftconv_same(camp)\n    den = _DEN_CACHE.get(b - a)\n\
      \    if den is None:                                   # edge correction, same\
      \ for equal lengths\n        den = np.maximum(_fftconv_same(np.ones(b - a)).real,\
      \ 1e-6)\n        _DEN_CACHE[b - a] = den\n    cfilt = num / den\n    x[a:b]\
      \ -= 2.0 * np.real(cfilt * cr)\n\n\n# ================================================================\
      \ Stage 6 block\nclass blk(gr.basic_block):\n    \"\"\"FT8 Subtract: remove\
      \ decoded signals and send the residual back to the search.\n\n    Each new\
      \ decode is rebuilt as an ideal FT8 waveform (GFSK, BT = 2) at its\n    frequency\
      \ and start time; its slowly varying amplitude and phase are measured\n    with\
      \ a ~0.33 s smoothing filter, and the fitted signal is subtracted. The residual\n\
      \    goes back to FT8 Sync Search as the next pass, where weaker signals that\
      \ were\n    hidden under the strong ones can now be found.\n    In 'audio':\
      \ the audio each pass was decoded from (from FT8 Demodulator)\n    In 'new'\
      \  : the decodes that pass produced (from FT8 Unpack + Report)\n    Out 'slot':\
      \ residual audio, pass + 1\n    \"\"\"\n\n    def __init__(self):\n        gr.basic_block.__init__(self,\
      \ name='FT8 Subtract', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('audio'))\n\
      \        self.message_port_register_in(pmt.intern('new'))\n        self.message_port_register_out(pmt.intern('slot'))\n\
      \        self.set_msg_handler(pmt.intern('audio'), self.on_audio)\n        self.set_msg_handler(pmt.intern('new'),\
      \ self.on_new)\n        self.cache = {}\n\n    def on_audio(self, m):\n    \
      \    d = from_msg(m)\n        self.cache[(d['slot'], d['pass'])] = np.asarray(d['audio'],\
      \ dtype=np.float64)\n        if len(self.cache) > 12:                      #\
      \ forget audio of finished slots\n            for k in sorted(self.cache)[:len(self.cache)\
      \ - 12]:\n                del self.cache[k]\n\n    def on_new(self, m):\n  \
      \      d = from_msg(m)\n        x = self.cache.pop((d['slot'], d['pass']), None)\n\
      \        if x is None:\n            return\n        x = x.copy()\n        tones\
      \ = np.asarray(d['tones'], dtype=int).reshape(-1, NN)\n        for t, f1, t0\
      \ in zip(tones, d['f1'], d['tstart']):\n            subtract(x, t, float(f1),\
      \ float(t0))\n        self.message_port_pub(pmt.intern('slot'), to_msg(dict(\n\
      \            slot=d['slot'], label=d['label'], pretty=d['pretty'], **{'pass':\
      \ d['pass'] + 1}, t0=d['t0'],\n            base=np.asarray(d['base'], dtype=np.float64),\
      \ audio=x.astype(np.float32))))\n"
    affinity: ''
    alias: ''
    comment: '6. Subtract decoded signals; the residual goes back

      to the sync search (passes 2 and 3)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''FT8 Subtract'', ''blk'', [], [(''audio'', ''message'', 1), (''new'',
      ''message'', 1)], [(''slot'', ''message'', 1)], "FT8 Subtract: remove decoded
      signals and send the residual back to the search.\n\n    Each new decode is
      rebuilt as an ideal FT8 waveform (GFSK, BT = 2) at its\n    frequency and start
      time; its slowly varying amplitude and phase are measured\n    with a ~0.33
      s smoothing filter, and the fitted signal is subtracted. The residual\n    goes
      back to FT8 Sync Search as the next pass, where weaker signals that were\n    hidden
      under the strong ones can now be found.\n    In ''audio'': the audio each pass
      was decoded from (from FT8 Demodulator)\n    In ''new''  : the decodes that
      pass produced (from FT8 Unpack + Report)\n    Out ''slot'': residual audio,
      pass + 1\n    ", [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 536.0]
    rotation: 180
    state: enabled
