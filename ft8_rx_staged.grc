- name: snippet_table
  id: snippet
  parameters:
    comment: Adds the decode table (UTC dB DT Freq Message) to the QT window
    section: main_after_init
    priority: '0'
    code: |
      # Put the FT8 decode table to the right of the spectrum/waterfall
      self.top_grid_layout.addWidget(self.ft8_report.make_widget(), 0, 1, 2, 1)
      self.top_grid_layout.setColumnStretch(0, 3)
      self.top_grid_layout.setColumnStretch(1, 2)
      self.resize(1400, 800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 12
    rotation: 0
    state: enabled
