options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Multi-signal FT8 decoder from a sound card
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ft8_rx_staged
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FT8 Multi-Signal Receiver, staged (sound card)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: f_max
  id: variable
  parameters:
    comment: Highest audio frequency searched [Hz]
    value: '3000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [540, 12]
    rotation: 0
    state: enabled
- name: f_min
  id: variable
  parameters:
    comment: Lowest audio frequency searched [Hz]
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 12]
    rotation: 0
    state: enabled
- name: ft8_rate
  id: variable
  parameters:
    comment: Decoder rate (fixed by the FT8 decoder)
    value: '12000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: passes
  id: variable
  parameters:
    comment: 1 = single pass (fastest). 2-3 = subtract decoded signals and decode
      the residual again (more decodes).
    value: '3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 12]
    rotation: 0
    state: enabled
- name: pc_clock
  id: variable
  parameters:
    comment: 'True: slots follow the PC clock (live sound card).

      False: slots counted from the first sample (WSJT-X .wav test files).'
    value: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [740, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Sound-card rate. 48 kHz works on every Windows sound card.
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: wav_file
  id: variable
  parameters:
    comment: WSJT-X saved slot (12 kHz mono) for the disabled test source
    value: '"C:/Users/me/AppData/Local/WSJT-X/save/000000_000000.wav"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [860, 12]
    rotation: 0
    state: enabled
- name: audio_source_0
  id: audio_source
  parameters:
    affinity: ''
    alias: ''
    comment: 'Sound card input (radio SPK/line out -> Line In / Mic).

      Device name blank = Windows default recording device.'
    device_name: ''''''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    ok_to_block: 'True'
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 224.0]
    rotation: 0
    state: enabled
- name: ft8_clock
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFS =\
      \ 12000                      # decoder sample rate\nNSPS = 1920            \
      \         # samples per FT8 symbol (0.16 s)\nNN = 79                       \
      \  # symbols per transmission\nCOSTAS = np.array([3, 1, 4, 0, 6, 5, 2])\nGRAY\
      \ = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone\nDATA_SYMS\
      \ = np.r_[7:36, 43:72]\nSYNC_SYMS = np.r_[0:7, 36:43, 72:79]\n\n\n# ---- message\
      \ helpers: every stage passes one PMT dict per slot and pass ----\ndef to_msg(d):\n\
      \    \"\"\"Python dict -> PMT dict. numpy arrays become uniform vectors (fast\
      \ path).\"\"\"\n    m = pmt.make_dict()\n    for k, v in d.items():\n      \
      \  if isinstance(v, np.ndarray):\n            a = v.ravel()\n            if\
      \ a.dtype == np.uint8:\n                p = pmt.init_u8vector(len(a), a.tolist())\n\
      \            elif a.dtype.kind == 'i':\n                p = pmt.init_s32vector(len(a),\
      \ a.astype(np.int32).tolist())\n            elif a.dtype.kind == 'c':\n    \
      \            p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())\n\
      \            elif a.dtype == np.float64:\n                p = pmt.init_f64vector(len(a),\
      \ a.tolist())\n            else:\n                p = pmt.init_f32vector(len(a),\
      \ a.astype(np.float32).tolist())\n        else:\n            p = pmt.to_pmt(v)\n\
      \        m = pmt.dict_add(m, pmt.intern(k), p)\n    return m\n\n\ndef from_msg(m):\n\
      \    return pmt.to_python(m)\n\n\n# ================================================================\
      \ Stage 1: slot clock\nimport sys\nimport time\nimport datetime\n\n_SLOT = 15.0\n\
      \n\nclass blk(gr.sync_block):\n    \"\"\"FT8 Slot Clock: 12 kHz audio in ->\
      \ one message per 15 s slot (the slot's audio).\n\n    pc_clock=True : slots\
      \ follow the PC clock (UTC :00/:15/:30/:45); live sound card.\n    pc_clock=False:\
      \ slots counted from the first sample (WSJT-X .wav test files).\n    decode_at\
      \     : seconds into the slot when the slot is sent (live mode).\n    clock_offset\
      \  : seconds added to the PC clock (sound-card latency), usually 0.\n    Output\
      \ 'slot': {slot, label, pretty, pass=0, t0, audio[180000]}\n    \"\"\"\n\n \
      \   def __init__(self, samp_rate=12000, decode_at=14.4, pc_clock=True, clock_offset=0.0):\n\
      \        gr.sync_block.__init__(self, name='FT8 Slot Clock', in_sig=[np.float32],\
      \ out_sig=None)\n        self.message_port_register_out(pmt.intern('slot'))\n\
      \        if int(samp_rate) != FS:\n            raise ValueError('FT8 Slot Clock\
      \ needs 12000 S/s input')\n        self.decode_at = float(decode_at)\n     \
      \   self.pc_clock = bool(pc_clock)\n        self.clock_offset = float(clock_offset)\n\
      \        self.buf = np.zeros(40 * FS, dtype=np.float32)        # ring buffer\n\
      \        self.n_total = 0\n        self.n_first = None\n        self.t_anchor\
      \ = None                                    # PC time of sample n_anchor\n \
      \       self.n_anchor = 0\n        self.err_min = np.inf\n        self.last_slot\
      \ = None\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        n = len(x)\n        now = time.time() + self.clock_offset\n       \
      \ L = len(self.buf)\n        i = self.n_total % L\n        if n >= L:\n    \
      \        self.buf[:] = x[-L:]\n        else:\n            k = min(n, L - i)\n\
      \            self.buf[i:i + k] = x[:k]\n            self.buf[:n - k] = x[k:]\n\
      \        if self.n_first is None:\n            self.n_first = self.n_total\n\
      \        self.n_total += n\n\n        if self.pc_clock:\n            if self.t_anchor\
      \ is None:\n                self.t_anchor, self.n_anchor = now, self.n_total\n\
      \            err = now - self._t_of(self.n_total)      # >= 0 apart from drift\n\
      \            if abs(err) > 1.0:                         # lost samples / clock\
      \ step: re-anchor\n                self.t_anchor, self.n_anchor = now, self.n_total\n\
      \                self.err_min = np.inf\n                err = 0.0\n        \
      \    self.err_min = min(self.err_min, err)\n            ts = np.floor((self._t_of(self.n_total)\
      \ - self.decode_at) / _SLOT) * _SLOT\n            if self.last_slot is None:\n\
      \                self.last_slot = ts                    # never decode a slot\
      \ we joined late\n            elif ts > self.last_slot:\n                self.last_slot\
      \ = ts\n                if np.isfinite(self.err_min):           # follow sound-card\
      \ clock drift\n                    self.t_anchor += self.err_min\n         \
      \           self.err_min = np.inf\n                n0 = self.n_anchor + int(round((ts\
      \ - self.t_anchor) * FS))\n                dtu = datetime.datetime.fromtimestamp(ts,\
      \ datetime.timezone.utc)\n                self._send(n0, ts, dtu.strftime('%H%M%S'),\
      \ dtu.strftime('%Y-%m-%d %H:%M:%S UTC'))\n        else:\n            k = self.n_total\
      \ // (15 * FS)\n            if self.last_slot is None:\n                self.last_slot\
      \ = -1\n            if k - 1 > self.last_slot:\n                self.last_slot\
      \ = k - 1\n                ts = self.last_slot * _SLOT\n                lab\
      \ = '%02d%02d%02d' % (ts // 3600 % 24, ts // 60 % 60, ts % 60)\n           \
      \     self._send(self.n_first + self.last_slot * 15 * FS, ts, lab, 'slot %s\
      \ (file time)' % lab)\n        return n\n\n    def _t_of(self, nn):\n      \
      \  return self.t_anchor + (nn - self.n_anchor) / float(FS)\n\n    def _send(self,\
      \ n0, ts, label, pretty):\n        L = len(self.buf)\n        seg = np.zeros(15\
      \ * FS, dtype=np.float32)\n        lo = max(n0, self.n_total - L, self.n_first)\n\
      \        hi = min(n0 + 15 * FS, self.n_total)\n        if hi - lo < 13 * FS:\
      \                           # less than 13 s of this slot: skip\n          \
      \  return\n        seg[lo - n0:hi - n0] = self.buf[np.arange(lo, hi) % L]\n\
      \        self.message_port_pub(pmt.intern('slot'), to_msg(dict(\n          \
      \  slot=float(ts), label=label, pretty=pretty, **{'pass': 0}, t0=time.time(),\
      \ audio=seg)))\n"
    affinity: ''
    alias: ''
    clock_offset: '0.0'
    comment: '1. Slot clock: cuts the audio into 15 s UTC slots

      (PC clock) and sends each slot as one message'
    decode_at: '14.4'
    maxoutbuf: '0'
    minoutbuf: '0'
    pc_clock: pc_clock
    samp_rate: ft8_rate
  states:
    _io_cache: '(''FT8 Slot Clock'', ''blk'', [(''samp_rate'', ''12000''), (''decode_at'',
      ''14.4''), (''pc_clock'', ''True''), (''clock_offset'', ''0.0'')], [(''0'',
      ''float'', 1)], [(''slot'', ''message'', 1)], "FT8 Slot Clock: 12 kHz audio
      in -> one message per 15 s slot (the slot''s audio).\n\n    pc_clock=True :
      slots follow the PC clock (UTC :00/:15/:30/:45); live sound card.\n    pc_clock=False:
      slots counted from the first sample (WSJT-X .wav test files).\n    decode_at     :
      seconds into the slot when the slot is sent (live mode).\n    clock_offset  :
      seconds added to the PC clock (sound-card latency), usually 0.\n    Output ''slot'':
      {slot, label, pretty, pass=0, t0, audio[180000]}\n    ", [''clock_offset'',
      ''decode_at'', ''pc_clock''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 372.0]
    rotation: 0
    state: enabled
- name: ft8_demod
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFS =\
      \ 12000                      # decoder sample rate\nNSPS = 1920            \
      \         # samples per FT8 symbol (0.16 s)\nNN = 79                       \
      \  # symbols per transmission\nCOSTAS = np.array([3, 1, 4, 0, 6, 5, 2])\nGRAY\
      \ = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone\nDATA_SYMS\
      \ = np.r_[7:36, 43:72]\nSYNC_SYMS = np.r_[0:7, 36:43, 72:79]\n\n\n# ---- message\
      \ helpers: every stage passes one PMT dict per slot and pass ----\ndef to_msg(d):\n\
      \    \"\"\"Python dict -> PMT dict. numpy arrays become uniform vectors (fast\
      \ path).\"\"\"\n    m = pmt.make_dict()\n    for k, v in d.items():\n      \
      \  if isinstance(v, np.ndarray):\n            a = v.ravel()\n            if\
      \ a.dtype == np.uint8:\n                p = pmt.init_u8vector(len(a), a.tolist())\n\
      \            elif a.dtype.kind == 'i':\n                p = pmt.init_s32vector(len(a),\
      \ a.astype(np.int32).tolist())\n            elif a.dtype.kind == 'c':\n    \
      \            p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())\n\
      \            elif a.dtype == np.float64:\n                p = pmt.init_f64vector(len(a),\
      \ a.tolist())\n            else:\n                p = pmt.init_f32vector(len(a),\
      \ a.astype(np.float32).tolist())\n        else:\n            p = pmt.to_pmt(v)\n\
      \        m = pmt.dict_add(m, pmt.intern(k), p)\n    return m\n\n\ndef from_msg(m):\n\
      \    return pmt.to_python(m)\n\n\n# ----------------------------------------------------------------\
      \ DSP\n_FS2 = 200\n_NFFT_BIG = 192000\n_NFFT2 = 3200\n_TAPER = 0.5 * (1.0 +\
      \ np.cos(np.arange(101) * np.pi / 100.0))\n_M32 = np.arange(32)\n_CSYNC = np.exp(2j\
      \ * np.pi * np.outer(COSTAS, _M32) / 32.0)\n_SYNC_OFF = np.concatenate([32 *\
      \ (np.arange(7) + 36 * g) for g in range(3)])\n_SYNC_TONE = np.tile(COSTAS,\
      \ 3)\n\n\nclass Downsampler:\n    \"\"\"One big FFT of the slot; per call: band\
      \ around f0 -> 200 S/s complex at 0 Hz.\"\"\"\n\n    def __init__(self, x):\n\
      \        self.cx = np.fft.rfft(x, _NFFT_BIG)\n        self.df = FS / _NFFT_BIG\n\
      \n    def __call__(self, f0):\n        df = self.df\n        i0 = int(round(f0\
      \ / df))\n        it = min(int(round((f0 + 8.5 * 6.25) / df)), _NFFT_BIG //\
      \ 2)\n        ib = max(1, int(round((f0 - 1.5 * 6.25) / df)))\n        k = it\
      \ - ib + 1\n        c1 = np.zeros(_NFFT2, dtype=complex)\n        c1[:k] = self.cx[ib:it\
      \ + 1]\n        c1[:101] *= _TAPER[::-1]\n        c1[k - 101:k] *= _TAPER\n\
      \        c1 = np.roll(c1, -(i0 - ib))\n        return np.fft.ifft(c1) * (_NFFT2\
      \ / np.sqrt(_NFFT_BIG * _NFFT2))\n\n\ndef _sync_power(cdp, starts, ref):\n \
      \   \"\"\"Coherent Costas correlation power for each start index (into padded\
      \ cd).\"\"\"\n    idx = starts[:, None, None] + _SYNC_OFF[None, :, None] + _M32[None,\
      \ None, :]\n    seg = cdp[idx]                                          # (P,21,32)\n\
      \    z = (seg * ref[None]).sum(axis=2)\n    return (z.real ** 2 + z.imag **\
      \ 2).sum(axis=1)\n\n\n_PADL = 400                                          \
      \       # padding (samples @200 S/s)\n\n\ndef fine_sync(ds, f0, xdt):\n    \"\
      \"\"WSJT-X style refinement. Returns (f1, i_start, cd) with cd padded by _PADL.\"\
      \"\"\n    cd = ds(f0)\n    cdp = np.concatenate([np.zeros(_PADL, complex), cd,\
      \ np.zeros(_PADL + 2600, complex)])\n    i0 = int(round((xdt + 0.5) * _FS2))\n\
      \    ref0 = np.conj(np.tile(_CSYNC, (3, 1)))                # (21,32)\n    starts\
      \ = np.arange(i0 - 10, i0 + 11) + _PADL\n    starts = np.clip(starts, 0, len(cdp)\
      \ - 1 - 32 * 79)\n    p = _sync_power(cdp, starts, ref0)\n    ibest = int(starts[np.argmax(p)])\
      \ - _PADL\n    best_f, best_p = 0.0, -1.0\n    tw_t = _M32 / _FS2\n    for delf\
      \ in np.arange(-2.5, 2.51, 0.5):\n        ref = ref0 * np.exp(-2j * np.pi *\
      \ delf * tw_t)[None, :]\n        pp = _sync_power(cdp, np.array([ibest + _PADL]),\
      \ ref)[0]\n        if pp > best_p:\n            best_p, best_f = pp, delf\n\
      \    f1 = f0 + best_f\n    cd = ds(f1)\n    cdp = np.concatenate([np.zeros(_PADL,\
      \ complex), cd, np.zeros(_PADL + 2600, complex)])\n    starts = np.arange(ibest\
      \ - 4, ibest + 5) + _PADL\n    starts = np.clip(starts, 0, len(cdp) - 1 - 32\
      \ * 79)\n    p = _sync_power(cdp, starts, ref0)\n    ibest = int(starts[np.argmax(p)])\
      \ - _PADL\n    return f1, ibest, cdp\n\n\ndef _bit_tables():\n    \"\"\"For\
      \ nsym=1,2,3: tone index tuples and bit masks for all 8**nsym hypotheses.\"\"\
      \"\n    tabs = {}\n    for nsym in (1, 2, 3):\n        nt = 8 ** nsym\n    \
      \    i = np.arange(nt)\n        digs = [(i >> (3 * (nsym - 1 - d))) & 7 for\
      \ d in range(nsym)]   # per symbol 3-bit value\n        tone = np.stack([GRAY[dg]\
      \ for dg in digs])                       # (nsym, nt)\n        nb = 3 * nsym\n\
      \        one = np.stack([(i >> (nb - 1 - b)) & 1 for b in range(nb)]).astype(bool)\
      \  # (nb, nt) MSB first\n        tabs[nsym] = (tone, one)\n    return tabs\n\
      \n\n_BITTAB = _bit_tables()\n\n\ndef soft_metrics(cs):\n    \"\"\"cs: (79,8)\
      \ complex tone amplitudes -> (4,174) normalized LLRs.\n    Rows: 1-symbol, 2-symbol\
      \ and 3-symbol coherent metrics, and the 1-symbol\n    metric normalized per\
      \ bit (same four variants WSJT-X tries).\"\"\"\n    out = np.zeros((4, 174))\n\
      \    for nsym in (1, 2, 3):\n        tone, one = _BITTAB[nsym]\n        nb =\
      \ 3 * nsym\n        for ihalf in range(2):\n            k = np.arange(0, 29,\
      \ nsym)\n            ks = k + 7 + 36 * ihalf\n            acc = np.zeros((len(ks),\
      \ tone.shape[1]), dtype=complex)\n            for d in range(nsym):\n      \
      \          kk = ks + d\n                acc += np.where((kk < 79)[:, None],\
      \ cs[np.minimum(kk, 78)][:, tone[d]], 0)\n            s2 = np.abs(acc)[:, None,\
      \ :]                       # (G,1,nt)\n            m1 = np.where(one[None],\
      \ s2, -1.0).max(axis=2)     # (G,nb)\n            m0 = np.where(~one[None],\
      \ s2, -1.0).max(axis=2)\n            pos = (k * 3 + ihalf * 87)[:, None] + np.arange(nb)[None,\
      \ :]\n            ok = pos < 174\n            out[nsym - 1, pos[ok]] = (m1 -\
      \ m0)[ok]\n            if nsym == 1:\n                den = np.maximum(m1, m0)\n\
      \                out[3, pos[ok]] = np.where(den > 0, (m1 - m0) / np.where(den\
      \ > 0, den, 1), 0)[ok]\n    sd = out.std(axis=1, keepdims=True)\n    sd[sd ==\
      \ 0] = 1.0\n    return 2.83 * out / sd\n\n\ndef symbol_spectra(cdp, ibest):\n\
      \    idx = ibest + _PADL + 32 * np.arange(NN)[:, None] + _M32[None, :]\n   \
      \ seg = cdp[idx]                                          # (79,32)\n    return\
      \ np.fft.fft(seg, axis=1)[:, :8]                   # (79,8)\n\n\n# ================================================================\
      \ Stage 3 block\nclass blk(gr.basic_block):\n    \"\"\"FT8 Demodulator: candidates\
      \ -> soft bits.\n\n    Per candidate: band-limit, shift to 0 Hz and decimate\
      \ to 200 S/s (one FFT of the\n    whole slot, one small IFFT per candidate),\
      \ fine time (+-50 ms) and frequency\n    (+-2.5 Hz) sync on the Costas arrays,\
      \ 79 x 8 tone amplitudes, and four soft-bit\n    metrics (1-, 2-, 3-symbol coherent\
      \ and normalized). Candidates whose sync tones are\n    mostly wrong (<= 6 of\
      \ 21) are dropped.\n    Output 'llr'  : slot info + f1[], ib[], llr[N*4*174],\
      \ cs[N*79*8], base[]\n    Output 'audio': slot, pass, audio (for FT8 Subtract)\n\
      \    \"\"\"\n\n    def __init__(self):\n        gr.basic_block.__init__(self,\
      \ name='FT8 Demodulator', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('cand'))\n\
      \        self.message_port_register_out(pmt.intern('llr'))\n        self.message_port_register_out(pmt.intern('audio'))\n\
      \        self.set_msg_handler(pmt.intern('cand'), self.handle)\n\n    def handle(self,\
      \ m):\n        d = from_msg(m)\n        x = np.asarray(d['audio'], dtype=np.float64)\n\
      \        self.message_port_pub(pmt.intern('audio'), to_msg(dict(slot=d['slot'],\
      \ **{'pass': d['pass']}, audio=d['audio'])))\n        f1s, ibs, llrs, css =\
      \ [], [], [], []\n        if len(d['f0']):\n            ds = Downsampler(x)\n\
      \            for f0, xdt in zip(d['f0'], d['xdt']):\n                f1, ib,\
      \ cdp = fine_sync(ds, float(f0), float(xdt))\n                cs = symbol_spectra(cdp,\
      \ ib)\n                hard = np.argmax(np.abs(cs), axis=1)\n              \
      \  if (hard[SYNC_SYMS] == _SYNC_TONE).sum() <= 6:\n                    continue\n\
      \                f1s.append(f1)\n                ibs.append(ib)\n          \
      \      llrs.append(soft_metrics(cs))\n                css.append(cs)\n     \
      \   out = {k: d[k] for k in ('slot', 'label', 'pretty', 'pass', 't0', 'base')}\n\
      \        out['f1'] = np.array(f1s, dtype=np.float64)\n        out['ib'] = np.array(ibs,\
      \ dtype=np.int32)\n        out['llr'] = np.array(llrs, dtype=np.float32).reshape(-1)\n\
      \        out['cs'] = np.array(css, dtype=np.complex64).reshape(-1)\n       \
      \ self.message_port_pub(pmt.intern('llr'), to_msg(out))\n"
    affinity: ''
    alias: ''
    comment: '3. Per candidate: shift to 0 Hz, decimate to 200 S/s,

      fine sync, 8-tone amplitudes -> soft bits'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''FT8 Demodulator'', ''blk'', [], [(''cand'', ''message'', 1)], [(''audio'',
      ''message'', 1), (''llr'', ''message'', 1)], "FT8 Demodulator: candidates ->
      soft bits.\n\n    Per candidate: band-limit, shift to 0 Hz and decimate to 200
      S/s (one FFT of the\n    whole slot, one small IFFT per candidate), fine time
      (+-50 ms) and frequency\n    (+-2.5 Hz) sync on the Costas arrays, 79 x 8 tone
      amplitudes, and four soft-bit\n    metrics (1-, 2-, 3-symbol coherent and normalized).
      Candidates whose sync tones are\n    mostly wrong (<= 6 of 21) are dropped.\n    Output
      ''llr''  : slot info + f1[], ib[], llr[N*4*174], cs[N*79*8], base[]\n    Output
      ''audio'': slot, pass, audio (for FT8 Subtract)\n    ", [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 392.0]
    rotation: 0
    state: enabled
- name: ft8_ldpc
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFS =\
      \ 12000                      # decoder sample rate\nNSPS = 1920            \
      \         # samples per FT8 symbol (0.16 s)\nNN = 79                       \
      \  # symbols per transmission\nCOSTAS = np.array([3, 1, 4, 0, 6, 5, 2])\nGRAY\
      \ = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone\nDATA_SYMS\
      \ = np.r_[7:36, 43:72]\nSYNC_SYMS = np.r_[0:7, 36:43, 72:79]\n\n\n# ---- message\
      \ helpers: every stage passes one PMT dict per slot and pass ----\ndef to_msg(d):\n\
      \    \"\"\"Python dict -> PMT dict. numpy arrays become uniform vectors (fast\
      \ path).\"\"\"\n    m = pmt.make_dict()\n    for k, v in d.items():\n      \
      \  if isinstance(v, np.ndarray):\n            a = v.ravel()\n            if\
      \ a.dtype == np.uint8:\n                p = pmt.init_u8vector(len(a), a.tolist())\n\
      \            elif a.dtype.kind == 'i':\n                p = pmt.init_s32vector(len(a),\
      \ a.astype(np.int32).tolist())\n            elif a.dtype.kind == 'c':\n    \
      \            p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())\n\
      \            elif a.dtype == np.float64:\n                p = pmt.init_f64vector(len(a),\
      \ a.tolist())\n            else:\n                p = pmt.init_f32vector(len(a),\
      \ a.astype(np.float32).tolist())\n        else:\n            p = pmt.to_pmt(v)\n\
      \        m = pmt.dict_add(m, pmt.intern(k), p)\n    return m\n\n\ndef from_msg(m):\n\
      \    return pmt.to_python(m)\n\n\n# ----------------------------------------------------------------\
      \ LDPC(174,91) parity checks\n_NM_TXT = (\n    '4,31,59,91,92,96,153;5,32,60,93,115,146;6,24,61,94,122,151;7,33,62,95,96,143;8,25,63,83,93,96,148;6,32,64,97,126,138;5,34,65,78,98,107,154;9,35,66,99,139,146;'\n\
      \    '10,36,67,100,107,126;11,37,67,87,101,139,158;12,38,68,102,105,155;13,39,69,103,149,162;8,40,70,82,104,114,145;14,41,71,88,102,123,156;15,42,59,106,123,159;1,33,72,106,107,157;'\n\
      \    '16,43,73,108,141,160;17,37,74,81,109,131,154;11,44,75,110,121,166;45,55,64,111,130,161,173;8,46,71,112,119,166;18,36,76,89,113,114,143;19,38,77,104,116,163;20,47,70,92,138,165;'\n\
      \    '2,48,74,113,128,160;21,45,78,83,117,121,151;22,47,58,118,127,164;16,39,62,112,134,158;23,43,79,120,131,145;19,35,59,73,110,125,161;20,36,63,94,136,161;14,31,79,98,132,164;'\n\
      \    '3,44,80,124,127,169;19,46,81,117,135,167;7,49,58,90,100,105,168;12,50,61,118,119,144;13,51,64,114,118,157;24,52,76,129,148,149;25,53,69,90,101,130,156;20,46,65,80,120,140,170;'\n\
      \    '21,54,77,100,140,171;35,82,133,142,171,174;14,30,83,113,125,170;4,29,68,120,134,173;1,4,52,57,86,136,152;26,51,56,91,122,137,168;52,84,110,115,145,168;7,50,81,99,132,173;'\n\
      \    '23,55,67,95,172,174;26,41,77,109,141,148;2,27,41,61,62,115,133;27,40,56,124,125,126;18,49,55,124,141,167;6,33,85,108,116,156;28,48,70,85,105,129,158;9,54,63,131,147,155;'\n\
      \    '22,53,68,109,121,174;3,13,48,78,95,123;31,69,133,150,155,169;12,43,66,89,97,135,159;5,39,75,102,136,167;2,54,86,101,135,164;15,56,87,108,119,171;10,44,82,91,111,144,149;'\n\
      \    '23,34,71,94,127,153;11,49,88,92,142,157;29,34,87,97,147,162;30,50,60,86,137,142,162;10,53,66,84,112,128,165;22,57,85,93,140,159;28,32,72,103,132,166;28,29,84,88,117,143,150;'\n\
      \    '1,26,45,80,128,147;17,27,89,103,116,153;51,57,98,163,165,172;21,37,73,138,152,169;16,47,76,130,137,154;3,24,30,72,104,139;9,40,90,106,134,151;15,58,60,74,111,150,163;'\n\
      \    '18,42,79,144,146,152;25,38,65,99,122,160;17,42,75,129,170,172'\n)\n\n\
      _NM = [[int(v) - 1 for v in r.split(',')] for r in _NM_TXT.split(';')]\n\n#\
      \ Tanner graph as edge lists\n_EC, _EV = [], []\nfor _c, _row in enumerate(_NM):\n\
      \    for _v in _row:\n        _EC.append(_c)\n        _EV.append(_v)\n_EC =\
      \ np.array(_EC)\n_EV = np.array(_EV)\n_NE = len(_EC)                       \
      \                # 522 edges\n_CHK_E = np.full((83, 7), _NE)               \
      \        # edge ids per check, pad -> dummy edge\n_VAR_E = np.zeros((174, 3),\
      \ dtype=int)               # edge ids per variable (3 each)\n_fill_c = np.zeros(83,\
      \ dtype=int)\n_fill_v = np.zeros(174, dtype=int)\nfor _e in range(_NE):\n  \
      \  _c, _v = _EC[_e], _EV[_e]\n    _CHK_E[_c, _fill_c[_c]] = _e\n    _fill_c[_c]\
      \ += 1\n    _VAR_E[_v, _fill_v[_v]] = _e\n    _fill_v[_v] += 1\n_CHK_V = np.where(_CHK_E\
      \ < _NE, _EV[np.minimum(_CHK_E, _NE - 1)], 174)  # var per check slot, pad ->\
      \ 174\n\n\n# ----------------------------------------------------------------\
      \ FEC: CRC-14, LDPC\ndef crc14(bits):\n    \"\"\"CRC-14 (poly 0x2757) of rows\
      \ of bits, shape (B, n) -> (B,) ints.\"\"\"\n    bits = np.atleast_2d(bits).astype(np.int64)\n\
      \    reg = np.zeros(bits.shape[0], dtype=np.int64)\n    for k in range(bits.shape[1]):\n\
      \        reg ^= bits[:, k] << 13\n        top = (reg >> 13) & 1\n        reg\
      \ = ((reg << 1) ^ (top * 0x2757)) & 0x3FFF\n    return reg\n\n\ndef crc_ok(a91):\n\
      \    \"\"\"a91: (B, 91) bits = 77 payload + 14 CRC. Valid and not all-zero.\"\
      \"\"\n    msg = np.concatenate([a91[:, :77], np.zeros((a91.shape[0], 5), dtype=a91.dtype)],\
      \ axis=1)\n    rx = np.zeros(a91.shape[0], dtype=np.int64)\n    for k in range(14):\n\
      \        rx = (rx << 1) | a91[:, 77 + k].astype(np.int64)\n    return (crc14(msg)\
      \ == rx) & (a91[:, :77].sum(axis=1) > 0)\n\n\ndef ldpc_bp(llr, max_iter=30):\n\
      \    \"\"\"Sum-product BP. llr: (B,174), positive = bit 1.\n    Returns (bits\
      \ (B,174) uint8, ok (B,) bool: all parity checks satisfied).\"\"\"\n    B =\
      \ llr.shape[0]\n    L = -np.asarray(llr, dtype=np.float64)           # work\
      \ with log(P0/P1)\n    m_cv = np.zeros((B, _NE + 1))                    # +1:\
      \ dummy edge\n    bits = np.zeros((B, 174), dtype=np.uint8)\n    done = np.zeros(B,\
      \ dtype=bool)\n    out = np.zeros((B, 174), dtype=np.uint8)\n    for _ in range(max_iter):\n\
      \        tot = L + m_cv[:, _VAR_E].sum(axis=2)        # (B,174)\n        bits\
      \ = (tot < 0).astype(np.uint8)\n        syn = bits[:, np.minimum(_CHK_V, 173)]\
      \ * (_CHK_V < 174)\n        ok = (syn.sum(axis=2) % 2 == 0).all(axis=1)\n  \
      \      newly = ok & ~done\n        out[newly] = bits[newly]\n        done |=\
      \ ok\n        if done.all():\n            break\n        m_vc = tot[:, _EV]\
      \ - m_cv[:, :_NE]           # (B,E)\n        t = np.tanh(np.clip(m_vc, -40,\
      \ 40) / 2.0)\n        t = np.concatenate([t, np.ones((B, 1))], axis=1)\n   \
      \     tc = t[:, _CHK_E]                            # (B,83,7)\n        sgn =\
      \ np.where(tc < 0, -1.0, 1.0)\n        la = np.log(np.maximum(np.abs(tc), 1e-30))\n\
      \        prod_l = la.sum(axis=2, keepdims=True) - la\n        prod_s = sgn.prod(axis=2,\
      \ keepdims=True) * sgn\n        v = np.clip(prod_s * np.exp(prod_l), -0.999999,\
      \ 0.999999)\n        msg = 2.0 * np.arctanh(v)\n        m_new = np.zeros((B,\
      \ _NE + 1))\n        m_new[:, _CHK_E.ravel()] = msg.reshape(B, -1)\n       \
      \ m_new[:, _NE] = 0.0\n        m_cv = m_new\n    out[~done] = bits[~done]\n\
      \    return out, done\n\n\n# ================================================================\
      \ Stage 4 block\nclass blk(gr.basic_block):\n    \"\"\"FT8 LDPC + CRC: soft\
      \ bits -> codewords.\n\n    Sum-product belief propagation on the (174,91) LDPC\
      \ code for every candidate and\n    all four soft-bit metrics at once (one numpy\
      \ batch). A candidate is accepted when\n    the parity checks are met, the CRC-14\
      \ matches, the payload is not all-zero and at\n    most 36 hard-decision bits\
      \ were corrected; the first metric that passes is used.\n    Output 'cw': slot\
      \ info + cw[K*174], f1[], ib[], cs[K*79*8], base[]\n    \"\"\"\n\n    def __init__(self,\
      \ max_iter=40):\n        gr.basic_block.__init__(self, name='FT8 LDPC + CRC',\
      \ in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('llr'))\n\
      \        self.message_port_register_out(pmt.intern('cw'))\n        self.set_msg_handler(pmt.intern('llr'),\
      \ self.handle)\n        self.max_iter = int(max_iter)\n\n    def handle(self,\
      \ m):\n        d = from_msg(m)\n        n = len(d['f1'])\n        keep, cws\
      \ = [], []\n        if n:\n            LL = np.asarray(d['llr'], dtype=np.float64).reshape(n\
      \ * 4, 174)\n            bits, ok = ldpc_bp(LL, self.max_iter)\n           \
      \ good = ok & crc_ok(bits[:, :91])\n            good &= ((LL > 0).astype(np.uint8)\
      \ != bits).sum(axis=1) <= 36\n            for c in range(n):\n             \
      \   rows = [4 * c + p for p in range(4) if good[4 * c + p]]\n              \
      \  if rows:\n                    keep.append(c)\n                    cws.append(bits[rows[0]])\n\
      \        cs = np.asarray(d['cs']).reshape(n, NN, 8) if n else np.zeros((0, NN,\
      \ 8), np.complex64)\n        out = {k: d[k] for k in ('slot', 'label', 'pretty',\
      \ 'pass', 't0', 'base')}\n        out['cw'] = np.array(cws, dtype=np.uint8).reshape(-1)\n\
      \        out['f1'] = np.asarray(d['f1'])[keep].astype(np.float64)\n        out['ib']\
      \ = np.asarray(d['ib'])[keep].astype(np.int32)\n        out['cs'] = cs[keep].reshape(-1)\n\
      \        self.message_port_pub(pmt.intern('cw'), to_msg(out))\n"
    affinity: ''
    alias: ''
    comment: 4. LDPC(174,91) belief propagation + CRC-14
    max_iter: '40'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''FT8 LDPC + CRC'', ''blk'', [(''max_iter'', ''40'')], [(''llr'',
      ''message'', 1)], [(''cw'', ''message'', 1)], "FT8 LDPC + CRC: soft bits ->
      codewords.\n\n    Sum-product belief propagation on the (174,91) LDPC code for
      every candidate and\n    all four soft-bit metrics at once (one numpy batch).
      A candidate is accepted when\n    the parity checks are met, the CRC-14 matches,
      the payload is not all-zero and at\n    most 36 hard-decision bits were corrected;
      the first metric that passes is used.\n    Output ''cw'': slot info + cw[K*174],
      f1[], ib[], cs[K*79*8], base[]\n    ", [''max_iter''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1216, 416.0]
    rotation: 0
    state: enabled
- name: ft8_report
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\nFS =\
      \ 12000                      # decoder sample rate\nNSPS = 1920            \
      \         # samples per FT8 symbol (0.16 s)\nNN = 79                       \
      \  # symbols per transmission\nCOSTAS = np.array([3, 1, 4, 0, 6, 5, 2])\nGRAY\
      \ = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone\nDATA_SYMS\
      \ = np.r_[7:36, 43:72]\nSYNC_SYMS = np.r_[0:7, 36:43, 72:79]\n\n\n# ---- message\
      \ helpers: every stage passes one PMT dict per slot and pass ----\ndef to_msg(d):\n\
      \    \"\"\"Python dict -> PMT dict. numpy arrays become uniform vectors (fast\
      \ path).\"\"\"\n    m = pmt.make_dict()\n    for k, v in d.items():\n      \
      \  if isinstance(v, np.ndarray):\n            a = v.ravel()\n            if\
      \ a.dtype == np.uint8:\n                p = pmt.init_u8vector(len(a), a.tolist())\n\
      \            elif a.dtype.kind == 'i':\n                p = pmt.init_s32vector(len(a),\
      \ a.astype(np.int32).tolist())\n            elif a.dtype.kind == 'c':\n    \
      \            p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())\n\
      \            elif a.dtype == np.float64:\n                p = pmt.init_f64vector(len(a),\
      \ a.tolist())\n            else:\n                p = pmt.init_f32vector(len(a),\
      \ a.astype(np.float32).tolist())\n        else:\n            p = pmt.to_pmt(v)\n\
      \        m = pmt.dict_add(m, pmt.intern(k), p)\n    return m\n\n\ndef from_msg(m):\n\
      \    return pmt.to_python(m)\n\n\n# ----------------------------------------------------------------\
      \ 77-bit message unpack\n_A37 = ' 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n_A36\
      \ = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n_A27 = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\
      _A38 = ' 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ/'\n_A42 = ' 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ+-./?'\n\
      _NTOKENS = 2063592\n_MAX22 = 4194304\n_MAXGRID4 = 32400\n_CSEC = ('AB AK AL\
      \ AR AZ BC CO CT DE EB EMA ENY EPA EWA GA GTA IA ID IL IN KS KY LA LAX MAR MB\
      \ MDC '\n         'ME MI MN MO MS MT NC ND NE NFL NH NL NLI NM NNJ NNY NT NTX\
      \ NV OH OK ONE ONN ONS OR ORG PAC '\n         'PR QC RI SB SC SCV SD SDG SF\
      \ SFL SJV SK SNJ STX SV TN UT VA VI VT WCF WI WMA WNY WPA WTX '\n         'WV\
      \ WWA WY DX').split()\n_CMULT = ('AL AK AZ AR CA CO CT DE FL GA HI ID IL IN\
      \ IA KS KY LA ME MD MA MI MN MS MO MT NE NV NH NJ '\n          'NM NY NC ND\
      \ OH OK OR PA RI SC SD TN TX UT VT VA WA WV WI WY NB NS QC ON MB SK AB BC NWT\
      \ NF '\n          'LB NU YT PEI DC').split()\n\n\nclass CallHash:\n    \"\"\"\
      Callsigns heard so far, keyed by their 22/12/10-bit hashes (for <...> fields).\"\
      \"\"\n\n    def __init__(self, max_entries=2000):\n        self.h22, self.h12,\
      \ self.h10 = {}, {}, {}\n        self.max_entries = max_entries\n\n    @staticmethod\n\
      \    def hash22(call):\n        n = 0\n        c = (call + ' ' * 11)[:11]\n\
      \        for ch in c:\n            j = _A38.find(ch)\n            if j < 0:\n\
      \                return None\n            n = 38 * n + j\n        return (((47055833459\
      \ * n) & 0xFFFFFFFFFFFFFFFF) >> 42) & 0x3FFFFF\n\n    def save(self, call):\n\
      \        call = call.strip()\n        if len(call) < 3 or call.startswith('<'):\n\
      \            return\n        h = self.hash22(call)\n        if h is None:\n\
      \            return\n        if len(self.h22) > self.max_entries:\n        \
      \    self.h22.clear(); self.h12.clear(); self.h10.clear()\n        self.h22[h]\
      \ = call\n        self.h12[h >> 10] = call\n        self.h10[h >> 12] = call\n\
      \n    def lookup(self, h, nbits):\n        d = {22: self.h22, 12: self.h12,\
      \ 10: self.h10}[nbits]\n        c = d.get(h)\n        return '<%s>' % c if c\
      \ else '<...>'\n\n\ndef _bits_to_int(b):\n    v = 0\n    for x in b:\n     \
      \   v = (v << 1) | int(x)\n    return v\n\n\ndef _unpack28(n28, ip, i3, hashes):\n\
      \    if n28 < _NTOKENS:\n        if n28 == 0:\n            return 'DE'\n   \
      \     if n28 == 1:\n            return 'QRZ'\n        if n28 == 2:\n       \
      \     return 'CQ'\n        if n28 <= 1002:\n            return 'CQ %03d' % (n28\
      \ - 3)\n        if n28 <= 532443:\n            n = n28 - 1003\n            s\
      \ = ''\n            for _ in range(4):\n                s = _A27[n % 27] + s\n\
      \                n //= 27\n            return 'CQ ' + s.strip()\n        return\
      \ None\n    n28 -= _NTOKENS\n    if n28 < _MAX22:\n        return hashes.lookup(n28,\
      \ 22)\n    n = n28 - _MAX22\n    c = [''] * 6\n    c[5] = _A27[n % 27]; n //=\
      \ 27\n    c[4] = _A27[n % 27]; n //= 27\n    c[3] = _A27[n % 27]; n //= 27\n\
      \    c[2] = '0123456789'[n % 10]; n //= 10\n    c[1] = _A36[n % 36]; n //= 36\n\
      \    if n >= 37:\n        return None\n    c[0] = _A37[n]\n    call = ''.join(c)\n\
      \    if call.startswith('3D0') and call[3] != ' ':\n        call = '3DA0' +\
      \ call[3:].strip()\n    elif call[0] == 'Q' and call[1].isalpha():\n       \
      \ call = '3X' + call[1:].strip()\n    call = call.strip()\n    if len(call)\
      \ < 3 or ' ' in call:\n        return None\n    hashes.save(call)\n    if ip:\n\
      \        if i3 == 1:\n            call += '/R'\n        elif i3 == 2:\n    \
      \        call += '/P'\n        else:\n            return None\n        hashes.save(call)\n\
      \    return call\n\n\ndef _grid_or_report(igrid4, ir):\n    if igrid4 <= _MAXGRID4:\n\
      \        n = igrid4\n        d3 = n % 10; n //= 10\n        d2 = n % 10; n //=\
      \ 10\n        l1 = n % 18; n //= 18\n        l0 = n % 18\n        g = chr(65\
      \ + l0) + chr(65 + l1) + str(d2) + str(d3)\n        return ('R ' + g) if ir\
      \ else g\n    irpt = igrid4 - _MAXGRID4\n    if irpt == 1:\n        return ''\n\
      \    if irpt == 2:\n        return 'RRR'\n    if irpt == 3:\n        return\
      \ 'RR73'\n    if irpt == 4:\n        return '73'\n    r = '%+03d' % (irpt -\
      \ 35)\n    return ('R' + r) if ir else r\n\n\ndef unpack77(b, hashes):\n   \
      \ \"\"\"b: 77 bits (array of 0/1). Returns message text or None (unsupported/invalid).\"\
      \"\"\n    b = [int(x) for x in b]\n    i3 = _bits_to_int(b[74:77])\n    n3 =\
      \ _bits_to_int(b[71:74])\n    if i3 in (1, 2):\n        c1 = _unpack28(_bits_to_int(b[0:28]),\
      \ b[28], i3, hashes)\n        c2 = _unpack28(_bits_to_int(b[29:57]), b[57],\
      \ i3, hashes)\n        if c1 is None or c2 is None:\n            return None\n\
      \        ex = _grid_or_report(_bits_to_int(b[59:74]), b[58])\n        if c1.startswith('CQ')\
      \ and ex.startswith('R'):\n            return None                      # implausible:\
      \ CQ with R/report\n        return ' '.join(x for x in (c1, c2, ex) if x)\n\
      \    if i3 == 4:\n        n12 = _bits_to_int(b[0:12])\n        n58 = _bits_to_int(b[12:70])\n\
      \        iflip, nrpt, icq = b[70], _bits_to_int(b[71:73]), b[73]\n        s\
      \ = ''\n        for _ in range(11):\n            s = _A38[n58 % 38] + s\n  \
      \          n58 //= 38\n        full = s.strip()\n        if len(full) < 3 or\
      \ ' ' in full:\n            return None\n        hashes.save(full)\n       \
      \ hc = hashes.lookup(n12, 12)\n        if icq:\n            return 'CQ ' + full\n\
      \        c1, c2 = (full, hc) if iflip else (hc, full)\n        ex = ('', 'RRR',\
      \ 'RR73', '73')[nrpt]\n        return ' '.join(x for x in (c1, c2, ex) if x)\n\
      \    if i3 == 3:\n        tu = b[0]\n        c1 = _unpack28(_bits_to_int(b[1:29]),\
      \ 0, 3, hashes)\n        c2 = _unpack28(_bits_to_int(b[29:57]), 0, 3, hashes)\n\
      \        if c1 is None or c2 is None:\n            return None\n        r =\
      \ b[57]\n        rst = '5%d9' % (_bits_to_int(b[58:61]) + 2)\n        s13 =\
      \ _bits_to_int(b[61:74])\n        if s13 > 8000:\n            if s13 - 8001\
      \ >= len(_CMULT):\n                return None\n            ex = _CMULT[s13\
      \ - 8001]\n        else:\n            ex = '%04d' % s13\n        parts = (['TU;']\
      \ if tu else []) + [c1, c2] + (['R'] if r else []) + [rst, ex]\n        return\
      \ ' '.join(parts)\n    if i3 == 5:\n        h12 = _bits_to_int(b[0:12])\n  \
      \      h22 = _bits_to_int(b[12:34])\n        r = b[34]\n        rst = '5%d9'\
      \ % (_bits_to_int(b[35:38]) + 2)\n        serial = _bits_to_int(b[38:49])\n\
      \        n = _bits_to_int(b[49:74])\n        d = [18 * 10 * 10 * 24 * 24, 10\
      \ * 10 * 24 * 24, 10 * 24 * 24, 24 * 24, 24, 1]\n        j = []\n        for\
      \ dv in d:\n            j.append(n // dv)\n            n -= j[-1] * dv\n   \
      \     if j[0] > 17 or j[1] > 17 or j[4] > 23 or j[5] > 23:\n            return\
      \ None\n        g6 = chr(65 + j[0]) + chr(65 + j[1]) + str(j[2]) + str(j[3])\
      \ + chr(65 + j[4]) + chr(65 + j[5])\n        return '%s %s %s%s%04d %s' % (hashes.lookup(h12,\
      \ 12), hashes.lookup(h22, 22),\n                                       'R '\
      \ if r else '', rst, serial, g6)\n    if i3 == 0:\n        if n3 == 0:     \
      \                     # free text\n            n = _bits_to_int(b[0:71])\n \
      \           s = ''\n            for _ in range(13):\n                s = _A42[n\
      \ % 42] + s\n                n //= 42\n            s = s.strip()\n         \
      \   return s if s else None\n        if n3 == 1:                          #\
      \ DXpedition\n            c1 = _unpack28(_bits_to_int(b[0:28]), 0, 0, hashes)\n\
      \            c2 = _unpack28(_bits_to_int(b[28:56]), 0, 0, hashes)\n        \
      \    if c1 is None or c2 is None:\n                return None\n           \
      \ h10 = _bits_to_int(b[56:66])\n            rpt = 2 * _bits_to_int(b[66:71])\
      \ - 30\n            return '%s RR73; %s %s %+03d' % (c1, c2, hashes.lookup(h10,\
      \ 10), rpt)\n        if n3 in (3, 4):                     # ARRL Field Day\n\
      \            c1 = _unpack28(_bits_to_int(b[0:28]), 0, 0, hashes)\n         \
      \   c2 = _unpack28(_bits_to_int(b[28:56]), 0, 0, hashes)\n            if c1\
      \ is None or c2 is None:\n                return None\n            r = b[56]\n\
      \            ntx = _bits_to_int(b[57:61]) + (1 if n3 == 3 else 17)\n       \
      \     cls = chr(65 + _bits_to_int(b[61:64]))\n            isec = _bits_to_int(b[64:71])\n\
      \            if isec < 1 or isec > len(_CSEC):\n                return None\n\
      \            return ' '.join([c1, c2] + (['R'] if r else []) + ['%d%s' % (ntx,\
      \ cls), _CSEC[isec - 1]])\n        if n3 == 5:                          # telemetry\n\
      \            v = _bits_to_int(b[0:71])\n            return ('%018X' % v).lstrip('0')\
      \ or '0'\n    return None\n\n\n# ================================================================\
      \ Stage 5 block\nimport sys\nimport time\n\n\ndef tones_from_cw(cw):\n    \"\
      \"\"174-bit codeword -> 79 channel tones (Costas + Gray-mapped data).\"\"\"\n\
      \    cw = np.asarray(cw, dtype=int)\n    t = np.zeros(NN, dtype=int)\n    t[SYNC_SYMS]\
      \ = np.tile(COSTAS, 3)\n    t[DATA_SYMS] = GRAY[cw[0::3] * 4 + cw[1::3] * 2\
      \ + cw[2::3]]\n    return t\n\n\nclass blk(gr.basic_block):\n    \"\"\"FT8 Unpack\
      \ + Report: codewords -> messages, table, and the subtraction loop.\n\n    Unpacks\
      \ each new 77-bit payload (duplicates from earlier passes are ignored),\n  \
      \  measures SNR (2500 Hz reference), DT and frequency, and keeps the slot's\
      \ list.\n    If more passes are allowed and this pass found something new, the\
      \ new decodes go\n    to FT8 Subtract ('new'), which sends the residual back\
      \ to the Sync Search.\n    Otherwise the slot is finished: WSJT-X style table\
      \ on the console and in the\n    QT window (Python Snippet calls make_widget()),\
      \ one PMT dict per decode on 'decodes'.\n    \"\"\"\n\n    def __init__(self,\
      \ passes=3, console=True):\n        gr.basic_block.__init__(self, name='FT8\
      \ Unpack + Report', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('cw'))\n\
      \        self.message_port_register_out(pmt.intern('new'))\n        self.message_port_register_out(pmt.intern('decodes'))\n\
      \        self.set_msg_handler(pmt.intern('cw'), self.handle)\n        self.passes\
      \ = max(1, int(passes))\n        self.console = bool(console)\n        self.hashes\
      \ = CallHash()\n        self.slots = {}\n        self._bridge = None\n     \
      \   self._header_done = False\n\n    def make_widget(self):\n        \"\"\"\
      Create the decode table. Call from the GUI thread (Python Snippet, Main - After\
      \ Init).\"\"\"\n        from PyQt5 import QtCore, QtGui, QtWidgets\n\n     \
      \   class _Bridge(QtCore.QObject):\n            slot_done = QtCore.pyqtSignal(object)\n\
      \n        w = QtWidgets.QWidget()\n        lay = QtWidgets.QVBoxLayout(w)\n\
      \        lay.setContentsMargins(0, 0, 0, 0)\n        top = QtWidgets.QHBoxLayout()\n\
      \        status = QtWidgets.QLabel('Waiting for the first FT8 slot ...')\n \
      \       clear = QtWidgets.QPushButton('Clear')\n        top.addWidget(status,\
      \ 1)\n        top.addWidget(clear)\n        lay.addLayout(top)\n        tbl\
      \ = QtWidgets.QTableWidget(0, 5)\n        tbl.setHorizontalHeaderLabels(['UTC',\
      \ 'dB', 'DT', 'Freq', 'Message'])\n        tbl.verticalHeader().setVisible(False)\n\
      \        tbl.setEditTriggers(QtWidgets.QAbstractItemView.NoEditTriggers)\n \
      \       tbl.setSelectionBehavior(QtWidgets.QAbstractItemView.SelectRows)\n \
      \       font = QtGui.QFont('Consolas')\n        font.setStyleHint(QtGui.QFont.Monospace)\n\
      \        tbl.setFont(font)\n        hh = tbl.horizontalHeader()\n        fm\
      \ = QtGui.QFontMetrics(font)\n        for c, sample in enumerate(('000000',\
      \ '-24', '-1.5', '0000')):\n            hh.setSectionResizeMode(c, QtWidgets.QHeaderView.Interactive)\n\
      \            tbl.setColumnWidth(c, fm.width(sample) + 18)\n        hh.setSectionResizeMode(4,\
      \ QtWidgets.QHeaderView.Stretch)\n        tbl.verticalHeader().setDefaultSectionSize(fm.height()\
      \ + 4)\n        lay.addWidget(tbl)\n        w.setMinimumWidth(460)\n       \
      \ clear.clicked.connect(lambda: tbl.setRowCount(0))\n        cq_bg = QtGui.QBrush(QtGui.QColor(200,\
      \ 255, 200))\n        sep_bg = QtGui.QBrush(QtGui.QColor(225, 225, 225))\n\n\
      \        def on_slot(info):\n            sb = tbl.verticalScrollBar()\n    \
      \        at_bottom = sb.value() >= sb.maximum() - 2\n            r = tbl.rowCount()\n\
      \            tbl.insertRow(r)\n            it = QtWidgets.QTableWidgetItem('----\
      \ %s  %d decodes  (%.1f s)' % (info['label'], len(info['rows']), info['secs']))\n\
      \            it.setBackground(sep_bg)\n            tbl.setItem(r, 0, it)\n \
      \           tbl.setSpan(r, 0, 1, 5)\n            for d in info['rows']:\n  \
      \              r = tbl.rowCount()\n                tbl.insertRow(r)\n      \
      \          vals = (info['utc'], '%d' % d['snr'], '%.1f' % d['dt'], '%d' % round(d['freq']),\
      \ d['msg'])\n                for c, v in enumerate(vals):\n                \
      \    item = QtWidgets.QTableWidgetItem(v)\n                    if c < 4:\n \
      \                       item.setTextAlignment(QtCore.Qt.AlignRight | QtCore.Qt.AlignVCenter)\n\
      \                    if d['msg'].startswith('CQ '):\n                      \
      \  item.setBackground(cq_bg)\n                    tbl.setItem(r, c, item)\n\
      \            excess = tbl.rowCount() - 3000\n            for _ in range(max(0,\
      \ excess)):\n                tbl.removeRow(0)\n            if at_bottom:\n \
      \               tbl.scrollToBottom()\n            status.setText(info['status'])\n\
      \n        self._bridge = _Bridge()\n        self._bridge.slot_done.connect(on_slot)\n\
      \        return w\n\n    def handle(self, m):\n        d = from_msg(m)\n   \
      \     key = d['slot']\n        st = self.slots.setdefault(key, {'seen': set(),\
      \ 'rows': []})\n        k = len(d['f1'])\n        cw = np.asarray(d['cw']).reshape(k,\
      \ 174) if k else np.zeros((0, 174), np.uint8)\n        cs = np.asarray(d['cs']).reshape(k,\
      \ NN, 8) if k else None\n        base = np.asarray(d['base'])\n        new =\
      \ []\n        for c in range(k):\n            a77 = cw[c, :77].astype(np.uint8)\n\
      \            kk = a77.tobytes()\n            if kk in st['seen']:\n        \
      \        continue\n            msg = unpack77(a77, self.hashes)\n          \
      \  if msg is None:\n                continue\n            st['seen'].add(kk)\n\
      \            f1 = float(d['f1'][c])\n            tones = tones_from_cw(cw[c])\n\
      \            sig_p = (np.abs(cs[c][np.arange(NN), tones]) ** 2).mean()\n   \
      \         i0 = max(0, int((f1 - 300.0) / 3.125))\n            i1 = min(len(base),\
      \ max(i0 + 2, int((f1 + 350.0) / 3.125)))\n            noise_cs = 32.0 * (np.percentile(base[i0:i1],\
      \ 20) / 0.513) / NSPS\n            arg = sig_p / max(noise_cs, 1e-30) - 1.0\n\
      \            snr = 10.0 * np.log10(max(arg, 1e-3)) - 28.3\n            new.append(dict(snr=int(round(max(snr,\
      \ -24.0))), dt=d['ib'][c] / 200.0 - 0.5,\n                            freq=f1,\
      \ msg=msg, tones=tones))\n        st['rows'] += new\n        if new and d['pass']\
      \ + 1 < self.passes:\n            self.message_port_pub(pmt.intern('new'), to_msg(dict(\n\
      \                slot=d['slot'], label=d['label'], pretty=d['pretty'], **{'pass':\
      \ d['pass']}, t0=d['t0'],\n                base=base, tones=np.array([r['tones']\
      \ for r in new], dtype=np.uint8).reshape(-1),\n                f1=np.array([r['freq']\
      \ for r in new], dtype=np.float64),\n                tstart=np.array([r['dt']\
      \ + 0.5 for r in new], dtype=np.float64))))\n            return\n        self._finish(d,\
      \ self.slots.pop(key)['rows'])\n\n    def _finish(self, d, rows):\n        rows.sort(key=lambda\
      \ r: r['freq'])\n        secs = time.time() - d['t0']\n        utc, pretty =\
      \ d['label'], d['pretty']\n        if self.console:\n            out = []\n\
      \            if not self._header_done:\n                out.append('UTC    \
      \ dB   DT  Freq  Message')\n                self._header_done = True\n     \
      \       out.append('------ %s : %d decodes (%.1f s, %d pass%s) ------'\n   \
      \                    % (pretty, len(rows), secs, d['pass'] + 1, '' if d['pass']\
      \ == 0 else 'es'))\n            for r in rows:\n                out.append('%s\
      \ %3d %4.1f %5d ~  %s' % (utc, r['snr'], r['dt'], round(r['freq']), r['msg']))\n\
      \            sys.stdout.write('\\n'.join(out) + '\\n')\n            sys.stdout.flush()\n\
      \        for r in rows:\n            meta = pmt.make_dict()\n            meta\
      \ = pmt.dict_add(meta, pmt.intern('utc'), pmt.intern(utc))\n            meta\
      \ = pmt.dict_add(meta, pmt.intern('snr'), pmt.from_long(int(r['snr'])))\n  \
      \          meta = pmt.dict_add(meta, pmt.intern('dt'), pmt.from_double(float(r['dt'])))\n\
      \            meta = pmt.dict_add(meta, pmt.intern('freq'), pmt.from_double(float(r['freq'])))\n\
      \            meta = pmt.dict_add(meta, pmt.intern('msg'), pmt.intern(r['msg']))\n\
      \            self.message_port_pub(pmt.intern('decodes'), meta)\n        if\
      \ self._bridge is not None:\n            status = 'Last slot %s: %d decodes,\
      \ %.1f s, %d pass%s' % (\n                pretty, len(rows), secs, d['pass']\
      \ + 1, '' if d['pass'] == 0 else 'es')\n            self._bridge.slot_done.emit(dict(label=pretty,\
      \ utc=utc, rows=rows, secs=secs, status=status))\n"
    affinity: ''
    alias: ''
    comment: '5. Unpack 77-bit messages, SNR/DT/Freq, table output.

      Decides whether another pass is needed.'
    console: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    passes: passes
  states:
    _io_cache: '(''FT8 Unpack + Report'', ''blk'', [(''passes'', ''3''), (''console'',
      ''True'')], [(''cw'', ''message'', 1)], [(''decodes'', ''message'', 1), (''new'',
      ''message'', 1)], "FT8 Unpack + Report: codewords -> messages, table, and the
      subtraction loop.\n\n    Unpacks each new 77-bit payload (duplicates from earlier
      passes are ignored),\n    measures SNR (2500 Hz reference), DT and frequency,
      and keeps the slot''s list.\n    If more passes are allowed and this pass found
      something new, the new decodes go\n    to FT8 Subtract (''new''), which sends
      the residual back to the Sync Search.\n    Otherwise the slot is finished: WSJT-X
      style table on the console and in the\n    QT window (Python Snippet calls make_widget()),
      one PMT dict per decode on ''decodes''.\n    ", [''console'', ''passes''])'
