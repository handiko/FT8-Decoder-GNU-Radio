- name: ft8_clock
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: '1. Slot clock: cuts the audio into 15 s UTC slots

      (PC clock) and sends each slot as one message'
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      import numpy as np
      import pmt
      from gnuradio import gr

      FS = 12000                      # decoder sample rate
      NSPS = 1920                     # samples per FT8 symbol (0.16 s)
      NN = 79                         # symbols per transmission
      COSTAS = np.array([3, 1, 4, 0, 6, 5, 2])
      GRAY = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone
      DATA_SYMS = np.r_[7:36, 43:72]
      SYNC_SYMS = np.r_[0:7, 36:43, 72:79]


      # ---- message helpers: every stage passes one PMT dict per slot and pass ----
      def to_msg(d):
          """Python dict -> PMT dict. numpy arrays become uniform vectors (fast path)."""
          m = pmt.make_dict()
          for k, v in d.items():
              if isinstance(v, np.ndarray):
                  a = v.ravel()
                  if a.dtype == np.uint8:
                      p = pmt.init_u8vector(len(a), a.tolist())
                  elif a.dtype.kind == 'i':
                      p = pmt.init_s32vector(len(a), a.astype(np.int32).tolist())
                  elif a.dtype.kind == 'c':
                      p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())
                  elif a.dtype == np.float64:
                      p = pmt.init_f64vector(len(a), a.tolist())
                  else:
                      p = pmt.init_f32vector(len(a), a.astype(np.float32).tolist())
              else:
                  p = pmt.to_pmt(v)
              m = pmt.dict_add(m, pmt.intern(k), p)
          return m


      def from_msg(m):
          return pmt.to_python(m)


      # ================================================================ Stage 1: slot clock
      import sys
      import time
      import datetime

      _SLOT = 15.0


      class blk(gr.sync_block):
          """FT8 Slot Clock: 12 kHz audio in -> one message per 15 s slot (the slot's audio).

          pc_clock=True : slots follow the PC clock (UTC :00/:15/:30/:45); live sound card.
          pc_clock=False: slots counted from the first sample (WSJT-X .wav test files).
          decode_at     : seconds into the slot when the slot is sent (live mode).
          clock_offset  : seconds added to the PC clock (sound-card latency), usually 0.
          Output 'slot': {slot, label, pretty, pass=0, t0, audio[180000]}
          """

          def __init__(self, samp_rate=12000, decode_at=14.4, pc_clock=True, clock_offset=0.0):
              gr.sync_block.__init__(self, name='FT8 Slot Clock', in_sig=[np.float32], out_sig=None)
              self.message_port_register_out(pmt.intern('slot'))
              if int(samp_rate) != FS:
                  raise ValueError('FT8 Slot Clock needs 12000 S/s input')
              self.decode_at = float(decode_at)
              self.pc_clock = bool(pc_clock)
              self.clock_offset = float(clock_offset)
              self.buf = np.zeros(40 * FS, dtype=np.float32)        # ring buffer
              self.n_total = 0
              self.n_first = None
              self.t_anchor = None                                    # PC time of sample n_anchor
              self.n_anchor = 0
              self.err_min = np.inf
              self.last_slot = None

          def work(self, input_items, output_items):
              x = input_items[0]
              n = len(x)
              now = time.time() + self.clock_offset
              L = len(self.buf)
              i = self.n_total % L
              if n >= L:
                  self.buf[:] = x[-L:]
              else:
                  k = min(n, L - i)
                  self.buf[i:i + k] = x[:k]
                  self.buf[:n - k] = x[k:]
              if self.n_first is None:
                  self.n_first = self.n_total
              self.n_total += n

              if self.pc_clock:
                  if self.t_anchor is None:
                      self.t_anchor, self.n_anchor = now, self.n_total
                  err = now - self._t_of(self.n_total)      # >= 0 apart from drift
                  if abs(err) > 1.0:                         # lost samples / clock step: re-anchor
                      self.t_anchor, self.n_anchor = now, self.n_total
                      self.err_min = np.inf
                      err = 0.0
                  self.err_min = min(self.err_min, err)
                  ts = np.floor((self._t_of(self.n_total) - self.decode_at) / _SLOT) * _SLOT
                  if self.last_slot is None:
                      self.last_slot = ts                    # never decode a slot we joined late
                  elif ts > self.last_slot:
                      self.last_slot = ts
                      if np.isfinite(self.err_min):           # follow sound-card clock drift
                          self.t_anchor += self.err_min
                          self.err_min = np.inf
                      n0 = self.n_anchor + int(round((ts - self.t_anchor) * FS))
                      dtu = datetime.datetime.fromtimestamp(ts, datetime.timezone.utc)
                      self._send(n0, ts, dtu.strftime('%H%M%S'), dtu.strftime('%Y-%m-%d %H:%M:%S UTC'))
              else:
                  k = self.n_total // (15 * FS)
                  if self.last_slot is None:
                      self.last_slot = -1
                  if k - 1 > self.last_slot:
                      self.last_slot = k - 1
                      ts = self.last_slot * _SLOT
                      lab = '%02d%02d%02d' % (ts // 3600 % 24, ts // 60 % 60, ts % 60)
                      self._send(self.n_first + self.last_slot * 15 * FS, ts, lab, 'slot %s (file time)' % lab)
              return n

          def _t_of(self, nn):
              return self.t_anchor + (nn - self.n_anchor) / float(FS)

          def _send(self, n0, ts, label, pretty):
              L = len(self.buf)
              seg = np.zeros(15 * FS, dtype=np.float32)
              lo = max(n0, self.n_total - L, self.n_first)
              hi = min(n0 + 15 * FS, self.n_total)
              if hi - lo < 13 * FS:                           # less than 13 s of this slot: skip
                  return
              seg[lo - n0:hi - n0] = self.buf[np.arange(lo, hi) % L]
              self.message_port_pub(pmt.intern('slot'), to_msg(dict(
                  slot=float(ts), label=label, pretty=pretty, **{'pass': 0}, t0=time.time(), audio=seg)))
    samp_rate: ft8_rate
    decode_at: '14.4'
    pc_clock: pc_clock
    clock_offset: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 330
    rotation: 0
    state: enabled
- name: ft8_search
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: '2. Costas sync search over the slot spectrogram

      -> candidate (frequency, time) list'
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      import numpy as np
      import pmt
      from gnuradio import gr

      FS = 12000                      # decoder sample rate
      NSPS = 1920                     # samples per FT8 symbol (0.16 s)
      NN = 79                         # symbols per transmission
      COSTAS = np.array([3, 1, 4, 0, 6, 5, 2])
      GRAY = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone
      DATA_SYMS = np.r_[7:36, 43:72]
      SYNC_SYMS = np.r_[0:7, 36:43, 72:79]


      # ---- message helpers: every stage passes one PMT dict per slot and pass ----
      def to_msg(d):
          """Python dict -> PMT dict. numpy arrays become uniform vectors (fast path)."""
          m = pmt.make_dict()
          for k, v in d.items():
              if isinstance(v, np.ndarray):
                  a = v.ravel()
                  if a.dtype == np.uint8:
                      p = pmt.init_u8vector(len(a), a.tolist())
                  elif a.dtype.kind == 'i':
                      p = pmt.init_s32vector(len(a), a.astype(np.int32).tolist())
                  elif a.dtype.kind == 'c':
                      p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())
                  elif a.dtype == np.float64:
                      p = pmt.init_f64vector(len(a), a.tolist())
                  else:
                      p = pmt.init_f32vector(len(a), a.astype(np.float32).tolist())
              else:
                  p = pmt.to_pmt(v)
              m = pmt.dict_add(m, pmt.intern(k), p)
          return m


      def from_msg(m):
          return pmt.to_python(m)


      # ---------------------------------------------------------------- DSP
      _TSTEP = 480                    # spectrogram hop: 1/4 symbol (40 ms)
      _NFFT1 = 3840                   # 1920 samples zero-padded -> 3.125 Hz bins
      _JSTRT = 12                     # 0.5 s / 40 ms
      _JZ = 62                        # lag search +-62 steps (+-2.48 s)
      _MLAG = 10                      # "narrow" lag search +-0.4 s


      def sync_search(x, fmin, fmax, syncmin=1.3, maxcand=300):
          """Coarse Costas search. Returns list of (f0 Hz, xdt s, sync) and the baseline
          (40th-percentile) spectrum power per 3.125 Hz bin."""
          nhsym = len(x) // _TSTEP - 3
          idx = np.arange(nhsym)[:, None] * _TSTEP + np.arange(NSPS)[None, :]
          X = np.fft.rfft(x[idx], _NFFT1, axis=1)
          s = (X.real ** 2 + X.imag ** 2).T                     # (1921 bins, nhsym)
          df = FS / _NFFT1
          ia = max(1, int(round(fmin / df)))
          ib = min(int(round(fmax / df)), s.shape[0] - 15)
          nf = ib - ia + 1
          pad = np.zeros((s.shape[0], _JZ + nhsym + _JZ + 300))
          pad[:, _JZ:_JZ + nhsym] = s
          tones = np.stack([pad[ia + 2 * k: ia + 2 * k + nf] for k in range(7)])   # (7,nf,T)
          t_g = np.zeros((3, nf, 2 * _JZ + 1))
          t0_g = np.zeros((3, nf, 2 * _JZ + 1))
          for g in range(3):
              for n in range(7):
                  m0 = _JSTRT + 4 * n + 144 * g                  # lag j=0 position
                  sl = tones[:, :, m0: m0 + 2 * _JZ + 1]        # j = -JZ..JZ (pad offset JZ cancels)
                  t_g[g] += sl[COSTAS[n]]
                  t0_g[g] += sl.sum(axis=0)
          eps = 1e-30
          t = t_g.sum(0)
          t0 = (t0_g.sum(0) - t) / 6.0
          sync_abc = t / (t0 + eps)
          tbc = t_g[1] + t_g[2]
          t0bc = (t0_g[1] + t0_g[2] - tbc) / 6.0
          sync_bc = tbc / (t0bc + eps)
          sync2d = np.maximum(sync_abc, sync_bc)                 # (nf, 2JZ+1)
          narrow = sync2d[:, _JZ - _MLAG: _JZ + _MLAG + 1]
          jp1 = np.argmax(narrow, axis=1) - _MLAG
          red1 = narrow.max(axis=1)
          jp2 = np.argmax(sync2d, axis=1) - _JZ
          red2 = sync2d.max(axis=1)
          base1 = np.sort(red1)[int(round(0.40 * nf))]
          base2 = np.sort(red2)[int(round(0.40 * nf))]
          red1 = red1 / max(base1, eps)
          red2 = red2 / max(base2, eps)
          cand = []
          for red, jp in ((red1, jp1), (red2, jp2)):
              order = np.argsort(-red)[:maxcand]
              for i in order:
                  if red[i] < syncmin:
                      break
                  cand.append(((ia + i) * df, (jp[i] - 0.5) * (_TSTEP / FS), float(red[i])))
          # remove near-duplicates (keep stronger)
          cand.sort(key=lambda c: -c[2])
          keep = []
          for c in cand:
              if all(abs(c[0] - k[0]) >= 4.0 or abs(c[1] - k[1]) >= 0.04 for k in keep):
                  keep.append(c)
              if len(keep) >= maxcand:
                  break
          # baseline noise spectrum (per 3.125 Hz bin), robust to signals
          base_spec = np.percentile(s, 40, axis=1)
          return keep, base_spec




      # ================================================================ Stage 2 block
      class blk(gr.basic_block):
          """FT8 Sync Search: slot audio -> candidate list.

          Builds a 3.125 Hz x 40 ms power spectrogram of the slot and scores the three
          7x7 Costas sync arrays at every frequency and time lag (-2.5 .. +2.5 s).
          Pass 0 audio comes from the Slot Clock; later passes are residual audio from
          FT8 Subtract (same input port).
          Output 'cand': input fields + f0[], xdt[], sync[], base[] (noise baseline per bin)
          """

          def __init__(self, f_min=200.0, f_max=3000.0, syncmin=1.2, maxcand=400):
              gr.basic_block.__init__(self, name='FT8 Sync Search', in_sig=None, out_sig=None)
              self.message_port_register_in(pmt.intern('slot'))
              self.message_port_register_out(pmt.intern('cand'))
              self.set_msg_handler(pmt.intern('slot'), self.handle)
              self.f_min, self.f_max = float(f_min), float(f_max)
              self.syncmin, self.maxcand = float(syncmin), int(maxcand)

          def handle(self, m):
              d = from_msg(m)
              x = np.asarray(d['audio'], dtype=np.float64)
              if d['pass'] == 0:
                  x = x / (np.std(x) + 1e-12)               # unit power; residuals keep this scale
              cands, base = sync_search(x, self.f_min, self.f_max, self.syncmin, self.maxcand) if np.any(x) else ([], np.zeros(1))
              d['audio'] = x.astype(np.float32)
              d['f0'] = np.array([c[0] for c in cands], dtype=np.float64)
              d['xdt'] = np.array([c[1] for c in cands], dtype=np.float64)
              d['sync'] = np.array([c[2] for c in cands], dtype=np.float64)
              if 'base' not in d:                            # keep the pass-0 noise baseline for SNR
                  d['base'] = base.astype(np.float64)
              self.message_port_pub(pmt.intern('cand'), to_msg(d))
    f_min: f_min
    f_max: f_max
    syncmin: '1.2'
    maxcand: '400'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 780
    - 330
    rotation: 0
    state: enabled
- name: ft8_demod
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: '3. Per candidate: shift to 0 Hz, decimate to 200 S/s,

      fine sync, 8-tone amplitudes -> soft bits'
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      import numpy as np
      import pmt
      from gnuradio import gr

      FS = 12000                      # decoder sample rate
      NSPS = 1920                     # samples per FT8 symbol (0.16 s)
      NN = 79                         # symbols per transmission
      COSTAS = np.array([3, 1, 4, 0, 6, 5, 2])
      GRAY = np.array([0, 1, 3, 2, 5, 6, 4, 7])          # 3 data bits -> tone
      DATA_SYMS = np.r_[7:36, 43:72]
      SYNC_SYMS = np.r_[0:7, 36:43, 72:79]


      # ---- message helpers: every stage passes one PMT dict per slot and pass ----
      def to_msg(d):
          """Python dict -> PMT dict. numpy arrays become uniform vectors (fast path)."""
          m = pmt.make_dict()
          for k, v in d.items():
              if isinstance(v, np.ndarray):
                  a = v.ravel()
                  if a.dtype == np.uint8:
                      p = pmt.init_u8vector(len(a), a.tolist())
                  elif a.dtype.kind == 'i':
                      p = pmt.init_s32vector(len(a), a.astype(np.int32).tolist())
                  elif a.dtype.kind == 'c':
                      p = pmt.init_c32vector(len(a), a.astype(np.complex64).tolist())
                  elif a.dtype == np.float64:
                      p = pmt.init_f64vector(len(a), a.tolist())
                  else:
                      p = pmt.init_f32vector(len(a), a.astype(np.float32).tolist())
              else:
                  p = pmt.to_pmt(v)
              m = pmt.dict_add(m, pmt.intern(k), p)
          return m


      def from_msg(m):
          return pmt.to_python(m)


      # ---------------------------------------------------------------- DSP
      _FS2 = 200
      _NFFT_BIG = 192000
      _NFFT2 = 3200
      _TAPER = 0.5 * (1.0 + np.cos(np.arange(101) * np.pi / 100.0))
      _M32 = np.arange(32)
      _CSYNC = np.exp(2j * np.pi * np.outer(COSTAS, _M32) / 32.0)
      _SYNC_OFF = np.concatenate([32 * (np.arange(7) + 36 * g) for g in range(3)])
      _SYNC_TONE = np.tile(COSTAS, 3)


      class Downsampler:
          """One big FFT of the slot; per call: band around f0 -> 200 S/s complex at 0 Hz."""

          def __init__(self, x):
              self.cx = np.fft.rfft(x, _NFFT_BIG)
              self.df = FS / _NFFT_BIG

          def __call__(self, f0):
              df = self.df
              i0 = int(round(f0 / df))
              it = min(int(round((f0 + 8.5 * 6.25) / df)), _NFFT_BIG // 2)
              ib = max(1, int(round((f0 - 1.5 * 6.25) / df)))
              k = it - ib + 1
              c1 = np.zeros(_NFFT2, dtype=complex)
              c1[:k] = self.cx[ib:it + 1]
              c1[:101] *= _TAPER[::-1]
              c1[k - 101:k] *= _TAPER
              c1 = np.roll(c1, -(i0 - ib))
              return np.fft.ifft(c1) * (_NFFT2 / np.sqrt(_NFFT_BIG * _NFFT2))


      def _sync_power(cdp, starts, ref):
          """Coherent Costas correlation power for each start index (into padded cd)."""
          idx = starts[:, None, None] + _SYNC_OFF[None, :, None] + _M32[None, None, :]
          seg = cdp[idx]                                          # (P,21,32)
          z = (seg * ref[None]).sum(axis=2)
          return (z.real ** 2 + z.imag ** 2).sum(axis=1)


      _PADL = 400                                                 # padding (samples @200 S/s)


      def fine_sync(ds, f0, xdt):
          """WSJT-X style refinement. Returns (f1, i_start, cd) with cd padded by _PADL."""
          cd = ds(f0)
          cdp = np.concatenate([np.zeros(_PADL, complex), cd, np.zeros(_PADL + 2600, complex)])
          i0 = int(round((xdt + 0.5) * _FS2))
          ref0 = np.conj(np.tile(_CSYNC, (3, 1)))                # (21,32)
          starts = np.arange(i0 - 10, i0 + 11) + _PADL
          starts = np.clip(starts, 0, len(cdp) - 1 - 32 * 79)
          p = _sync_power(cdp, starts, ref0)
          ibest = int(starts[np.argmax(p)]) - _PADL
          best_f, best_p = 0.0, -1.0
          tw_t = _M32 / _FS2
          for delf in np.arange(-2.5, 2.51, 0.5):
              ref = ref0 * np.exp(-2j * np.pi * delf * tw_t)[None, :]
              pp = _sync_power(cdp, np.array([ibest + _PADL]), ref)[0]
              if pp > best_p:
                  best_p, best_f = pp, delf
          f1 = f0 + best_f
          cd = ds(f1)
          cdp = np.concatenate([np.zeros(_PADL, complex), cd, np.zeros(_PADL + 2600, complex)])
          starts = np.arange(ibest - 4, ibest + 5) + _PADL
          starts = np.clip(starts, 0, len(cdp) - 1 - 32 * 79)
          p = _sync_power(cdp, starts, ref0)
          ibest = int(starts[np.argmax(p)]) - _PADL
          return f1, ibest, cdp


      def _bit_tables():
          """For nsym=1,2,3: tone index tuples and bit masks for all 8**nsym hypotheses."""
          tabs = {}
          for nsym in (1, 2, 3):
              nt = 8 ** nsym
              i = np.arange(nt)
              digs = [(i >> (3 * (nsym - 1 - d))) & 7 for d in range(nsym)]   # per symbol 3-bit value
              tone = np.stack([GRAY[dg] for dg in digs])                       # (nsym, nt)
              nb = 3 * nsym
              one = np.stack([(i >> (nb - 1 - b)) & 1 for b in range(nb)]).astype(bool)  # (nb, nt) MSB first
              tabs[nsym] = (tone, one)
          return tabs


      _BITTAB = _bit_tables()


      def soft_metrics(cs):
          """cs: (79,8) complex tone amplitudes -> (4,174) normalized LLRs.
          Rows: 1-symbol, 2-symbol and 3-symbol coherent metrics, and the 1-symbol
          metric normalized per bit (same four variants WSJT-X tries)."""
          out = np.zeros((4, 174))
          for nsym in (1, 2, 3):
              tone, one = _BITTAB[nsym]
              nb = 3 * nsym
              for ihalf in range(2):
                  k = np.arange(0, 29, nsym)
                  ks = k + 7 + 36 * ihalf
                  acc = np.zeros((len(ks), tone.shape[1]), dtype=complex)
                  for d in range(nsym):
                      kk = ks + d
                      acc += np.where((kk < 79)[:, None], cs[np.minimum(kk, 78)][:, tone[d]], 0)
                  s2 = np.abs(acc)[:, None, :]                       # (G,1,nt)
                  m1 = np.where(one[None], s2, -1.0).max(axis=2)     # (G,nb)
                  m0 = np.where(~one[None], s2, -1.0).max(axis=2)
                  pos = (k * 3 + ihalf * 87)[:, None] + np.arange(nb)[None, :]
                  ok = pos < 174
                  out[nsym - 1, pos[ok]] = (m1 - m0)[ok]
                  if nsym == 1:
                      den = np.maximum(m1, m0)
                      out[3, pos[ok]] = np.where(den > 0, (m1 - m0) / np.where(den > 0, den, 1), 0)[ok]
          sd = out.std(axis=1, keepdims=True)
          sd[sd == 0] = 1.0
          return 2.83 * out / sd


      def symbol_spectra(cdp, ibest):
          idx = ibest + _PADL + 32 * np.arange(NN)[:, None] + _M32[None, :]
          seg = cdp[idx]                                          # (79,32)
          return np.fft.fft(seg, axis=1)[:, :8]                   # (79,8)


      # ================================================================ Stage 3 block
      class blk(gr.basic_block):
          """FT8 Demodulator: candidates -> soft bits.

          Per candidate: band-limit, shift to 0 Hz and decimate to 200 S/s (one FFT of the
          whole slot, one small IFFT per candidate), fine time (+-50 ms) and frequency
          (+-2.5 Hz) sync on the Costas arrays, 79 x 8 tone amplitudes, and four soft-bit
          metrics (1-, 2-, 3-symbol coherent and normalized). Candidates whose sync tones are
          mostly wrong (<= 6 of 21) are dropped.
          Output 'llr'  : slot info + f1[], ib[], llr[N*4*174], cs[N*79*8], base[]
          Output 'audio': slot, pass, audio (for FT8 Subtract)
          """

          def __init__(self):
              gr.basic_block.__init__(self, name='FT8 Demodulator', in_sig=None, out_sig=None)
              self.message_port_register_in(pmt.intern('cand'))
              self.message_port_register_out(pmt.intern('llr'))
              self.message_port_register_out(pmt.intern('audio'))
              self.set_msg_handler(pmt.intern('cand'), self.handle)

          def handle(self, m):
              d = from_msg(m)
              x = np.asarray(d['audio'], dtype=np.float64)
              self.message_port_pub(pmt.intern('audio'), to_msg(dict(slot=d['slot'], **{'pass': d['pass']}, audio=d['audio'])))
              f1s, ibs, llrs, css = [], [], [], []
              if len(d['f0']):
                  ds = Downsampler(x)
                  for f0, xdt in zip(d['f0'], d['xdt']):
                      f1, ib, cdp = fine_sync(ds, float(f0), float(xdt))
                      cs = symbol_spectra(cdp, ib)
                      hard = np.argmax(np.abs(cs), axis=1)
                      if (hard[SYNC_SYMS] == _SYNC_TONE).sum() <= 6:
                          continue
                      f1s.append(f1)
                      ibs.append(ib)
                      llrs.append(soft_metrics(cs))
                      css.append(cs)
              out = {k: d[k] for k in ('slot', 'label', 'pretty', 'pass', 't0', 'base')}
              out['f1'] = np.array(f1s, dtype=np.float64)
              out['ib'] = np.array(ibs, dtype=np.int32)
              out['llr'] = np.array(llrs, dtype=np.float32).reshape(-1)
              out['cs'] = np.array(css, dtype=np.complex64).reshape(-1)
              self.message_port_pub(pmt.intern('llr'), to_msg(out))
